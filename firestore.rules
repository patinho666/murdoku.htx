rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No login system beyond a name, so these rules are intentionally open.
    // Anyone with your site URL can read/write — fine for a private game
    // with friends, but lock this down further if you ever make it public.
    match /users/{userId} {
      allow read, write: if true;
      match /progress/{puzzleId} {
        allow read, write: if true;
      }
    }
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
